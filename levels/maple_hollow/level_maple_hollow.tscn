[sub_resource type="Shader" id="Shader_j6pnr"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_mix, depth_draw_never;

uniform vec4 mist_color : source_color = vec4(0.38, 0.52, 0.62, 0.19);

void fragment() {
	vec2 d = UV * 2.0 - vec2(1.0);
	float r = length(d);
	float soft = smoothstep(1.0, 0.15, r);
	ALBEDO = mist_color.rgb;
	ALPHA = mist_color.a * soft * soft;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_8rxju"]
render_priority = 0
shader = SubResource("Shader_j6pnr")

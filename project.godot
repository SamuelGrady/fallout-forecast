[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="shelter"
3d_physics/layer_5="puddle"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.0470588, 0.0784314, 0.133333, 1)
lights_and_shadows/directional_shadow/size.web=512
anti_aliasing/quality/msaa_3d.web=0

[gui]

theme/custom_font="res://assets/fonts/VT323-Regular.ttf"
theme/default_font_size=20

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fallout Forecast"
run/main_scene="res://ui/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0
driver/output_latency.web=180

[autoload]

Net="*res://game/net.gd"
WeatherManager="*res://weather/weather_manager.gd"
Settings="*res://game/settings.gd"
Sound="*res://game/sound.gd"
RNG="*res://game/rng.gd"
GameManager="*res://game/game_manager.gd"
Playtest="*res://game/playtest.gd"
MenuState="*res://ui/menu_state.gd"
Preload="*res://game/preload.gd"
SceneLoader="*res://game/scene_loader.gd"
Perf="*res://game/perf.gd"
Juice="*res://game/juice.gd"
Telemetry="*res://game/telemetry.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="canvas_items"

